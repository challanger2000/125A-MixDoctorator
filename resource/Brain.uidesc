    <view class="CTextLabel" origin="0,338" size="940,24" title="LISTEN FOR THIS" font-size="14" font-color="#ccccccff" transparent="true"/>
    <view class="CMultiLineTextLabel" origin="0,368" size="940,72" control-tag="CoachListen" font-size="15" font-color="#ffffffff" back-color="#292929ff" frame-color="#666666ff" line-layout="wrap" vertical-centered="true"/>

    <view class="CTextLabel" origin="0,468" size="940,24" title="IF IT DOES NOT SOUND BETTER" font-size="14" font-color="#ccccccff" transparent="true"/>
    <view class="CMultiLineTextLabel" origin="0,498" size="940,64" title="Undo the change. A measured overlap is not automatically a mix problem, and MixDoctorator should never replace listening." font-size="15" font-color="#ffffffff" back-color="#252525ff" frame-color="#555555ff" line-layout="wrap" vertical-centered="true"/>

    <view class="CTextLabel" origin="0,590" size="940,22" title="SECONDARY CHECK: ATTACK / TRANSIENT SPACE" font-size="12" font-color="#888888ff" transparent="true"/>
